# Database
DATABASE_URL="postgresql://user:password@localhost:5432/loopback"

# Twilio (SMS review requests)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Postmark (email review requests)
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_EMAIL="reviews@yourdomain.com"

# Google Places API (used once per business, at onboarding, to resolve Place ID)
GOOGLE_PLACES_API_KEY=""

# Base URL used to build the short review-request links sent to customers
APP_BASE_URL="http://localhost:3000"
